# ===============================
# Application
# ===============================
spring.application.name=medicalapp

# ===============================
# Server
# ===============================
server.port=8080

# ===============================
# Datasource (PostgreSQL)
# ===============================
spring.datasource.url=jdbc:postgresql://localhost:5432/medicalapp
spring.datasource.username=postgres
spring.datasource.password=password
spring.datasource.driver-class-name=org.postgresql.Driver

# ===============================
# JPA / Hibernate
# ===============================
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# ===============================
# Logging SQL (opcional)
# ===============================
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# ===============================
# FLYWAY
# ===============================
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true

# Debug only
spring.flyway.fail-on-missing-locations=true
spring.flyway.validate-on-migrate=true
logging.level.org.flywaydb=DEBUG

# JWT Configuration
jwt.secret=key-prueba-cambiar_m�nimo-32bytes-o-da-error-dafdsfsdfsdfdsf
jwt.access.expiration=3600000      # 1 hora
jwt.refresh.expiration=604800000  # 7 d�as